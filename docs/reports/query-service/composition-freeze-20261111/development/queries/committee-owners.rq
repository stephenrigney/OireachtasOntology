PREFIX a: <https://data.oireachtas.ie/ontology#>
PREFIX m: <https://data.oireachtas.ie/ontology/members#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT DISTINCT * WHERE {
GRAPH <https://data.oireachtas.ie/graph/committees> {
 ?committee skos:prefLabel ?label .
 FILTER(LCASE(STR(?label)) IN ("committee of public accounts", "committee on public accounts"))
 OPTIONAL { ?committee a ?committeeType } OPTIONAL { ?committee m:committeeInHouseTerm ?term }
 OPTIONAL { ?committee m:hasCommitteeDateRange ?range . OPTIONAL { ?range a ?rangeType }
 OPTIONAL { ?range m:StartDate ?start } OPTIONAL { ?range m:EndDate ?end } }
}
} ORDER BY ?committee ?committeeType ?end ?label ?range ?rangeType ?start ?term LIMIT 100
