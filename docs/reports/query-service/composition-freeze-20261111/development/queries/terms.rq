PREFIX a: <https://data.oireachtas.ie/ontology#>
PREFIX m: <https://data.oireachtas.ie/ontology/members#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT DISTINCT * WHERE {
GRAPH <https://data.oireachtas.ie/graph/houses> {
 ?term a ?termType . VALUES ?termType { a:DailTerm a:SeanadTerm }
 OPTIONAL { ?term a:termNo ?number } OPTIONAL { ?term a:termOf ?house }
 OPTIONAL { ?term dct:temporal ?period .
 OPTIONAL { ?period a ?periodType } OPTIONAL { ?period dcat:startDate ?start }
 OPTIONAL { ?period dcat:endDate ?end } }
}
} ORDER BY ?end ?house ?number ?period ?periodType ?start ?term ?termType LIMIT 100
