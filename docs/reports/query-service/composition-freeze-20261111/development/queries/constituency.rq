PREFIX a: <https://data.oireachtas.ie/ontology#>
PREFIX m: <https://data.oireachtas.ie/ontology/members#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT DISTINCT * WHERE {
GRAPH <https://data.oireachtas.ie/graph/constituencies> {
 ?constituency skos:prefLabel ?label . FILTER(STR(?label) = "Dublin Central")
 ?constituency m:constituencyInHouseTerm <https://data.oireachtas.ie/ie/oireachtas/house/dail/34> .
 OPTIONAL { ?constituency a ?constituencyType }
 OPTIONAL { ?constituency m:constituencyInHouseTerm ?term }
}
} ORDER BY ?constituency ?constituencyType ?label ?term LIMIT 100
