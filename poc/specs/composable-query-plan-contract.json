{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractId": "https://data.oireachtas.ie/specs/composable-query-plan-contract",
  "schemaVersion": 1,
  "contractVersion": "2.8.0",
  "planVersion": 2,
  "scope": "Local Oireachtas query planning; Stage A, Stage B and Stage C plans use one shared typed v2 envelope with closed family-specific semantic projections.",
  "resolutionOutcomes": ["unresolved", "resolved", "ambiguous", "not_found", "source_data_unavailable", "unsupported_mapping"],
  "entityTypes": ["Member", "DailMembership", "SeanadMembership", "CommitteeMembership", "DailTerm", "SeanadTerm", "DailConstituency", "SeanadPanel", "SeanadRepresentation", "Committee", "ParliamentaryCollectionMembership", "ParliamentaryMemberCollection", "IndependentMemberCollection", "PartyMembershipEpisode", "ParliamentaryParty", "PoliticalAffiliationIdentity", "OfficeHolding", "NamedOffice", "DebateRecord", "DebateSitting", "BillParticipation", "Bill", "BillProcess", "BillActivity", "ExplanatoryMemoWork"],
  "entityTypeRdfTypes": {"Member": "agents:Member", "DailMembership": "members:DailMembership", "SeanadMembership": "members:SeanadMembership", "CommitteeMembership": "members:CommitteeMembership", "DailTerm": "agents:DailTerm", "SeanadTerm": "agents:SeanadTerm", "DailConstituency": "members:DailConstituency", "SeanadPanel": "members:SeanadPanel", "SeanadRepresentation": "members:Constituencies", "Committee": "members:Committee", "ParliamentaryCollectionMembership": "members:ParliamentaryCollectionMembership", "ParliamentaryMemberCollection": "members:ParliamentaryMemberCollection", "IndependentMemberCollection": "members:IndependentMemberCollection", "PartyMembershipEpisode": "members:PartyMembership", "ParliamentaryParty": "members:ParliamentaryParty", "PoliticalAffiliationIdentity": "members:PoliticalAffiliationIdentity", "OfficeHolding": "members:OfficeHolding", "NamedOffice": "members:NamedOffice", "DebateRecord": "agents:DebateRecord", "DebateSitting": "agents:DebateSitting", "BillParticipation": "eli-dl:Participation", "Bill": "eli-dl:DraftLegislationWork", "BillProcess": "eli-dl:LegislativeProcess", "BillActivity": "eli-dl:LegislativeActivity", "ExplanatoryMemoWork": "eli:Work"},
  "relations": [
    {"id": "constituency_in_term", "subjectType": "DailConstituency", "objectType": "DailTerm", "predicate": "members:constituencyInHouseTerm", "subjectGraph": "constituencies", "objectGraph": "houses"},
    {"id": "member_has_membership", "subjectType": "Member", "objectType": "DailMembership", "patternId": "member-house-membership", "predicate": "members:hasMembersMembership", "subjectGraph": "member-records", "objectGraph": "member-records"},
    {"id": "membership_in_term", "subjectType": "DailMembership", "objectType": "DailTerm", "patternId": "member-house-membership", "predicate": "members:inHouseTerm", "subjectGraph": "member-records", "objectGraph": "houses"},
    {"id": "membership_represents", "subjectType": "DailMembership", "objectType": "DailConstituency", "predicate": "members:isRepresentativeFrom", "subjectGraph": "member-records", "objectGraph": "constituencies"},
    {"id": "member_party_membership", "subjectType": "Member", "objectType": "PartyMembershipEpisode", "predicate": "members:hasMembersMembership", "subjectGraph": "member-records", "objectGraph": "member-records"},
    {"id": "episode_in_parliamentary_party", "subjectType": "PartyMembershipEpisode", "objectType": "ParliamentaryParty", "predicate": "members:isPartyMembershipOf", "subjectGraph": "member-records", "objectGraph": "parties"},
    {"id": "parliamentary_party_has_affiliation_identity", "subjectType": "ParliamentaryParty", "objectType": "PoliticalAffiliationIdentity", "predicate": "members:hasPoliticalAffiliationIdentity", "subjectGraph": "parties", "objectGraph": "political-affiliations"},
    {"id": "member_has_office_holding", "subjectType": "Member", "objectType": "OfficeHolding", "predicate": "members:hasOfficeHolding", "subjectGraph": "member-records", "objectGraph": "member-records"},
    {"id": "office_holding_of_office", "subjectType": "OfficeHolding", "objectType": "NamedOffice", "predicate": "members:heldOffice", "subjectGraph": "member-records", "objectGraph": "offices"},
    {"id": "sitting_produced_record", "subjectType": "DebateSitting", "objectType": "DebateRecord", "predicate": "agents:producedRecord", "subjectGraph": "debates", "objectGraph": "debates"},
    {"id": "party_active_during_term", "subjectType": "ParliamentaryParty", "objectType": "DailTerm", "patternId": "party-term-occurrence", "predicate": "members:activeDuringTerm", "subjectGraph": "parties", "objectGraph": "houses"},
    {"id": "bill_has_sponsor_participation", "subjectType": "Bill", "objectType": "BillParticipation", "patternId": "bill-sponsor-reference", "association": "same_named_graph_co_ownership", "viaType": "eli-dl:LegislativeProcess", "subjectGraph": "bill-records", "objectGraph": "bill-records", "joinKey": "same Bill-owned named graph; no direct Bill-to-process predicate"},
    {"id": "participation_has_participant", "subjectType": "BillParticipation", "objectType": "Member", "patternId": "bill-sponsor-reference", "predicate": "eli-dl:had_participant_person", "subjectGraph": "bill-records", "objectGraph": "member-records", "joinKey": "same RDF resource IRI"}
    ,{"id": "member_has_seanad_membership", "subjectType": "Member", "objectType": "SeanadMembership", "patternId": "member-house-membership", "predicate": "members:hasMembersMembership", "subjectGraph": "member-records", "objectGraph": "member-records"}
    ,{"id": "seanad_membership_in_term", "subjectType": "SeanadMembership", "objectType": "SeanadTerm", "patternId": "member-house-membership", "predicate": "members:inHouseTerm", "subjectGraph": "member-records", "objectGraph": "houses"}
    ,{"id": "seanad_membership_represents", "subjectType": "SeanadMembership", "objectType": "SeanadPanel", "patternId": "representation-reference", "predicate": "members:isRepresentativeFrom", "subjectGraph": "member-records", "objectGraph": "constituencies"}
    ,{"id": "member_has_committee_membership", "subjectType": "Member", "objectType": "CommitteeMembership", "patternId": "committee-membership-reference", "predicate": "members:hasMembersMembership", "subjectGraph": "member-records", "objectGraph": "member-records"}
    ,{"id": "committee_membership_of_committee", "subjectType": "CommitteeMembership", "objectType": "Committee", "patternId": "committee-membership-reference", "predicate": "members:isCommitteeMembershipOf", "subjectGraph": "member-records", "objectGraph": "committees"}
    ,{"id": "committee_in_term", "subjectType": "Committee", "objectType": "DailTerm", "patternId": "committee-description", "predicate": "members:committeeInHouseTerm", "subjectGraph": "committees", "objectGraph": "houses"}
    ,{"id": "committee_in_seanad_term", "subjectType": "Committee", "objectType": "SeanadTerm", "patternId": "committee-description", "predicate": "members:committeeInHouseTerm", "subjectGraph": "committees", "objectGraph": "houses"}
    ,{"id": "member_has_collection_membership", "subjectType": "Member", "objectType": "ParliamentaryCollectionMembership", "patternId": "member-collection-membership", "predicate": "members:hasMembersMembership", "subjectGraph": "member-records", "objectGraph": "member-records"}
    ,{"id": "collection_membership_of_collection", "subjectType": "ParliamentaryCollectionMembership", "objectType": "ParliamentaryMemberCollection", "patternId": "member-collection-membership", "predicate": "members:memberOfCollection", "subjectGraph": "member-records", "objectGraph": "parties"}
    ,{"id": "seanad_membership_represents_resource", "subjectType": "SeanadMembership", "objectType": "SeanadRepresentation", "patternId": "representation-reference", "predicate": "members:isRepresentativeFrom", "subjectGraph": "member-records", "objectGraph": "constituencies"}
    ,{"id": "bill_process_cocontained", "subjectType": "Bill", "objectType": "BillProcess", "patternId": "bill-lifecycle", "association": "same_named_graph_co_ownership", "subjectGraph": "bill-records", "objectGraph": "bill-records", "joinKey": "same Bill-owned named graph; no direct Bill-to-process predicate"}
    ,{"id": "activity_forms_part_of_process", "subjectType": "BillActivity", "objectType": "BillProcess", "patternId": "bill-lifecycle", "predicate": "eli-dl:forms_part_of", "subjectGraph": "bill-records", "objectGraph": "bill-records"}
    ,{"id": "process_has_participation", "subjectType": "BillProcess", "objectType": "BillParticipation", "patternId": "bill-sponsor-reference", "predicate": "eli-dl:had_participation", "subjectGraph": "bill-records", "objectGraph": "bill-records"}
    ,{"id": "bill_has_explanatory_memo_work", "subjectType": "Bill", "objectType": "ExplanatoryMemoWork", "patternId": "bill-document-work-links", "predicate": "eli:has_part", "subjectGraph": "bill-records", "objectGraph": "bill-records", "note": "The typed Work constraint is family-specific and requires the reviewed ExplanatoryMemo -> LegalExpression -> Format rendition chain."}
  ],
  "questionFamilies": [
    {"id": "member_lookup", "cases": ["Q01", "Q32", "Q34"], "referentType": "Member", "patterns": ["member-description"], "semantics": "Grounded name tokens resolve to zero, one, or a set of distinct local Member IRIs; ambiguity is not collapsed."},
    {"id": "previous_service", "cases": ["Q02"], "referentType": "DailMembership", "patterns": ["member-house-membership", "house-term-temporal-reference"], "semantics": "Previous Dáil is selected from HouseTerm start/end evidence relative to explicit asOf; membership is tested in that term."},
    {"id": "dail_duration", "cases": ["Q03"], "referentType": "DailMembership", "patterns": ["member-house-membership"], "semantics": "Cumulative service is the union of dated membership intervals through asOf; gaps are preserved and open ends are not unbounded."},
    {"id": "term_count", "cases": ["Q04", "T01"], "referentType": "DailTerm", "patterns": ["member-house-membership", "house-term-description"], "semantics": "Count distinct HouseTerm resource identities, never membership rows or replacement people."},
    {"id": "seanad_entry", "cases": ["Q05"], "referentType": "SeanadMembership", "patterns": ["member-house-membership", "constituency-term-occurrence"], "semantics": "Earliest dated Seanad membership and later episodes remain distinct; representation is displayed only as the source-provided designation."},
    {"id": "current_collection", "cases": ["Q07", "Q08"], "referentType": "ParliamentaryMemberCollection", "patterns": ["member-collection-membership", "party-term-occurrence"], "semantics": "Dated collection membership is evaluated at asOf; IndependentMemberCollection is a parliamentary status, not a political party."},
    {"id": "seanad_representation", "cases": ["Q10"], "referentType": "SeanadRepresentation", "patterns": ["member-house-membership", "representation-reference", "constituency-term-occurrence"], "semantics": "Report the term-scoped mapped representation resource/designation without coercing panel, university constituency, or an unmapped Taoiseach nomination category into one another."},
    {"id": "committee_boolean", "cases": ["Q11"], "referentType": "Committee", "patterns": ["committee-membership-reference", "committee-description", "house-term-temporal-reference"], "semantics": "Unscoped committee names default to a uniquely evidenced incarnation current at asOf; absent/ambiguous current-date evidence is unavailable, not yes/no."},
    {"id": "committee_count", "cases": ["Q13"], "referentType": "Committee", "patterns": ["committee-membership-reference"], "semantics": "Count distinct Committee IRI identities, not repeated CommitteeMembership records."},
    {"id": "house_terms", "cases": ["Q15"], "referentType": "DailTerm", "patterns": ["house-term-description", "house-term-temporal-reference"], "semantics": "Chronological House-owned start/end evidence distinguishes a current open term from an unclassified missing end."},
    {"id": "dail_all", "cases": ["Q33"], "referentType": "Member", "patterns": ["member-description", "member-house-membership"], "semantics": "Set-valued exact-name resolution returns every distinct Member identity with DáilMembership evidence."},
    {"id": "bill_title_search", "cases": ["Q18"], "referentType": "Bill", "patterns": ["bill-lifecycle"], "semantics": "Resolve a supplied title mention; the approved AI abbreviation expands to Artificial Intelligence; retain multiple distinct Bill identities as candidates and never choose by guess."},
    {"id": "bills_published", "cases": ["Q19"], "referentType": "BillActivity", "patterns": ["bill-lifecycle"], "semantics": "Use any typed BillActivity with exact Published type and mapped xsd:date in the requested calendar year; legislativeYear is not a publication-date fallback."},
    {"id": "non_enacted_bills", "cases": ["Q20"], "referentType": "Bill", "patterns": ["bill-lifecycle"], "semantics": "Include every known status other than Enacted, report grouped local counts, and fail closed on missing or conflicting process statuses."},
    {"id": "bill_status_history", "cases": ["Q21"], "referentType": "Bill", "patterns": ["bill-lifecycle"], "semantics": "Resolve the supplied Bill title mention; report source-backed status and queryable dated lifecycle activities, never infer a next step."},
    {"id": "bill_sponsors", "cases": ["Q22"], "referentType": "BillParticipation", "patterns": ["bill-sponsor-reference", "member-description"], "semantics": "Return all Bill-owned Participation records including unknown primary and role-only evidence; Member labels join only by exact RDF IRI through the reviewed Member owner graph."},
    {"id": "bill_lookup", "cases": ["Q24A"], "referentType": "Bill", "patterns": ["bill-lifecycle", "bill-document-work-links"], "semantics": "Resolve exact Bill number/year; display English title, mapped status, official link, available dated activity evidence, and only typed explanatory-memorandum rendition chains recorded in the same Bill-owned graph."},
    {"id": "committee_chair", "cases": ["Q12"], "referentType": "Committee", "patterns": ["committee-description"], "semantics": "Resolve a uniquely dated current Committee owner first; report chair evidence gap because no chair/office-holder predicate is queryable; do not infer from membership."},
    {"id": "committee_conflict", "cases": ["Q14"], "referentType": "Committee", "patterns": [], "semantics": "Report the reviewed development source conflict/quarantine as a coverage failure, not a planning failure or current roster."},
    {"id": "office_month_overlap", "cases": ["Q25"], "referentType": "OfficeHolding", "patterns": ["conditionally-resolved-office-holdings", "named-office-description", "member-description"], "semantics": "Reuse the accepted inclusive calendar-window OfficeHolding path; resolve the named Member to one exact local Member IRI, bind the Member referent by identity (never display label), and show tenure start/end evidence."},
    {"id": "office_current_coverage", "cases": ["Q26"], "referentType": "OfficeHolding", "patterns": ["conditionally-resolved-office-holdings", "named-office-description"], "semantics": "Require complete current coverage; the incomplete development holding sample and office aliases do not establish a current holder."},
    {"id": "office_date_point", "cases": ["Q27"], "referentType": "OfficeHolding", "patterns": ["conditionally-resolved-office-holdings", "named-office-description"], "semantics": "Reuse accepted inclusive calendar-date OfficeHolding evidence for the requested point date."},
    {"id": "dail_seats", "cases": ["Q16"], "referentType": "DailTerm", "patterns": ["house-term-seat-complement"], "semantics": "Resolve one typed DailTerm by its exact numeric term ordinal and report its authoritative agents:seats value; never count Member records."},
    {"id": "dail_parties_and_groups", "cases": ["Q17"], "referentType": "ParliamentaryParty", "patterns": ["party-term-occurrence", "house-term-ordinal"], "semantics": "Resolve one typed DailTerm first, then list term-scoped ParliamentaryParty records for that exact identity, preserving rows with missing labels; separately report ParliamentaryGroup coverage as missing because no current group instances are emitted."},
    {"id": "bill_quarantine", "cases": ["Q24"], "referentType": "Bill", "patterns": ["bill-lifecycle"], "semantics": "Check only the exact Bill-owned graph for 2024/48; an absent graph is explained by the reviewed source quarantine, not ordinary title-resolution failure or proof of nonexistence."},
    {"id": "debate_lookup", "cases": ["Q31"], "referentType": "DebateSitting", "patterns": ["debate-sitting-record"], "semantics": "Reuse the reviewed actual-sitting to produced DebateRecord path and graph-route chamber identity; local absence is not a claim that no debate occurred."},
    {"id": "committee_topic_latest", "cases": ["Q30"], "referentType": "Committee", "patterns": [], "semantics": "Resolve the reviewed alias PAC to Committee of Public Accounts, but do not infer substantive HSE examination or latest coverage from the pinned metadata-only hearing."},
    {"id": "bill_votes", "cases": ["Q36"], "referentType": "Bill", "patterns": [], "semantics": "Bill-linked voting is unavailable; sponsorship participation is not voting evidence."},
    {"id": "debate_transcript", "cases": ["Q37"], "referentType": "DebateSitting", "patterns": [], "semantics": "Transcript speech content is unavailable because no approved transcript retrieval path exists; Debate metadata and links are not speech content."}
  ],
  "constraints": [
    {"id": "debate_sitting_date", "referentType": "DebateSitting", "field": "date", "operator": "on", "valueKind": "date", "predicate": "eli-dl:activity_date", "graphFamily": "debates"},
    {"id": "debate_record_chamber", "referentType": "DebateRecord", "field": "chamber", "operator": "equals", "valueKind": "controlled_route", "graphFamily": "debates", "allowedValues": [{"id": "dail", "route": "dail"}, {"id": "seanad", "route": "seanad"}]},
    {"id": "office_holding_interval", "referentType": "OfficeHolding", "field": "interval", "operator": "overlaps", "valueKind": "inclusive_calendar_date_interval", "graphFamily": "member-records", "dateRangePredicate": "members:hasMembershipDateRange", "startPredicate": "members:StartDate", "endPredicate": "members:EndDate", "dateDatatype": "xsd:dateTime", "endAbsentMeans": "open-ended", "boundary": "inclusive_calendar_day"},
    {"id": "office_member_identity", "referentType": "Member", "field": "memberIdentity", "operator": "equals", "valueKind": "local_resource_iri", "graphFamily": "member-records", "meaning": "Bind the person-role Member referent to the exact resolved local Member IRI; labels are display-only and cannot satisfy identity."}
  ],
  "answer": {"kinds": ["entities", "boolean"], "identity": "RDF resource IRI", "displayAttributes": ["name", "label", "date", "officialLink", "englishTitle", "billNumber", "year"], "supportingEvidence": "distinct relationship episodes; preserve separate dated records and Bill sponsorship participations before Bill-identity deduplication", "episodeProjection": {"referentType": "OfficeHolding", "fields": ["start", "end"], "preserveSeparateHoldings": true}, "sponsorshipProjection": {"referentType": "BillParticipation", "fields": ["role", "primaryEvidence"], "preserveSeparateParticipations": true, "billIdentity": "RDF resource IRI", "billProcessAssociation": "same Bill-owned named graph co-ownership; no direct Bill-to-process predicate"}},
  "relativeTerm": {"operation": "previousTerm", "houseType": "DailTerm", "asOf": "required", "dateMapping": {"graphFamily": "houses", "periodLinkPredicate": "dct:temporal", "startPredicate": "dcat:startDate", "endPredicate": "dcat:endDate"}, "endAbsentMeans": "open-ended", "labelChronology": false}
}
