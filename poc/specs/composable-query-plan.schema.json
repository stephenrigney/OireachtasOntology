{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.oireachtas.ie/specs/composable-query-plan.schema.json",
  "title": "Oireachtas Composable Query Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asOf", "referents", "relations", "answer"],
  "properties": {
    "version": {"const": 2},
    "asOf": {"type": "string", "format": "date"},
    "referents": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["type"],
        "properties": {
          "type": {"enum": ["Member", "DailMembership", "DailTerm", "DailConstituency"]},
          "selector": {"type": "object", "additionalProperties": false,
            "required": ["kind", "house"], "properties": {"kind": {"const": "previousTerm"}, "house": {"const": "Dail"}}},
          "mention": {"type": "string", "minLength": 1},
          "answer": {"type": "boolean"},
          "resolution": {"enum": ["resolved", "ambiguous", "not_found"]},
          "iri": {"type": "string", "format": "uri"},
          "label": {"type": "string"},
          "asOfEvidence": {"type": "string", "format": "date"},
          "candidates": {"type": "array", "items": {"type": "object", "required": ["iri", "label"], "properties": {"iri": {"type": "string", "format": "uri"}, "label": {"type": "string"}}}}
        }
      }
    },
    "relations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fact", "from", "to"],
      "properties": {"id": {"type": "string", "minLength": 1}, "fact": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}
    }},
    "answer": {"type": "object", "additionalProperties": false,
      "required": ["kind", "referent", "distinctBy", "display"],
      "properties": {"kind": {"const": "entities"}, "referent": {"type": "string", "minLength": 1}, "distinctBy": {"const": "identity"}, "display": {"const": ["name"]}}
    }
  }
}
