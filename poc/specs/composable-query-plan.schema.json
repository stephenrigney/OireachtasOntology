{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.oireachtas.ie/specs/composable-query-plan.schema.json",
  "title": "Oireachtas Composable Query Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asOf"],
  "allOf": [
    {"if": {"required": ["family"]}, "then": {"required": ["family"], "properties": {"family": {"enum": ["member_lookup", "previous_service", "dail_duration", "term_count", "seanad_entry", "seanad_representation", "current_collection", "committee_boolean", "committee_count", "house_terms", "dail_all", "bill_title_search", "bills_published", "non_enacted_bills", "bill_status_history", "bill_sponsors", "bill_lookup", "committee_chair", "committee_conflict", "office_overlap", "office_current_coverage", "office_point"]}}}},
    {"if": {"required": ["family"]}, "then": {"required": ["referents", "relations", "answer"]}},
    {"if": {"not": {"required": ["family"]}}, "then": {"required": ["referents", "relations", "answer"], "properties": {"relations": {"minItems": 1}}}},
    {"if": {"required": ["family"], "properties": {"family": {"enum": ["bill_title_search", "bills_published", "non_enacted_bills", "bill_status_history", "bill_sponsors", "bill_lookup", "committee_chair", "committee_conflict", "office_overlap", "office_current_coverage", "office_point"]}}}, "then": {"properties": {"answer": {"required": ["projection"]}}}}
  ],
  "properties": {
    "version": {"const": 2},
    "asOf": {"type": "string", "format": "date"},
    "family": {"enum": ["member_lookup", "previous_service", "dail_duration", "term_count", "seanad_entry", "seanad_representation", "current_collection", "committee_boolean", "committee_count", "house_terms", "dail_all", "bill_title_search", "bills_published", "non_enacted_bills", "bill_status_history", "bill_sponsors", "bill_lookup", "committee_chair", "committee_conflict", "office_overlap", "office_current_coverage", "office_point"]},
    "referents": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type"],
        "properties": {
          "type": {"enum": ["Member", "DailMembership", "SeanadMembership", "CommitteeMembership", "DailTerm", "SeanadTerm", "DailConstituency", "SeanadPanel", "SeanadRepresentation", "Committee", "ParliamentaryCollectionMembership", "ParliamentaryMemberCollection", "IndependentMemberCollection", "PartyMembershipEpisode", "ParliamentaryParty", "PoliticalAffiliationIdentity", "OfficeHolding", "NamedOffice", "DebateRecord", "DebateSitting", "BillParticipation", "Bill", "BillProcess", "BillActivity", "ExplanatoryMemoWork"]},
          "selector": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind", "house"], "properties": {"kind": {"const": "previousTerm"}, "house": {"const": "Dail"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "year", "number"], "properties": {"kind": {"const": "numberYear"}, "year": {"type": "integer", "minimum": 1800, "maximum": 2200}, "number": {"type": "string", "pattern": "^[0-9]+$"}}}
          ]},
          "mention": {"type": "string", "minLength": 1},
          "answer": {"type": "boolean"},
          "resolution": {"enum": ["unresolved", "resolved", "ambiguous", "not_found", "source_data_unavailable", "unsupported_mapping"]},
          "iri": {"type": "string", "format": "uri"},
          "label": {"type": "string"},
          "asOfEvidence": {"type": "string", "format": "date"},
          "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["iri", "label"], "properties": {"iri": {"type": "string", "format": "uri"}, "label": {"type": "string"}}}}
        }
      }
    },
    "relations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fact", "from", "to"],
      "properties": {"id": {"type": "string", "minLength": 1}, "fact": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}
    }},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "answer": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "referent"], "properties": {"kind": {"const": "family_result"}, "referent": {"type": "string", "minLength": 1}, "projection": {"enum": ["bill_lookup", "bill_title_search", "bills_published", "non_enacted_bills", "bill_status_history", "bill_sponsors", "committee_chair", "committee_conflict", "office_overlap", "office_point", "office_current_coverage"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "referent", "distinctBy"], "properties": {"kind": {"const": "count"}, "referent": {"type": "string", "minLength": 1}, "distinctBy": {"const": "identity"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "referent"], "properties": {"kind": {"const": "values"}, "referent": {"type": "string", "minLength": 1}}},
      {"$ref": "#/$defs/entityAnswer"},
      {"$ref": "#/$defs/booleanAnswer"}
    ]}
  },
  "$defs": {
    "inclusiveCalendarInterval": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "inclusive"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "inclusive": {"const": true}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "field", "operator", "value"],
      "properties": {
        "referent": {"type": "string", "minLength": 1},
        "field": {"enum": ["interval", "date", "chamber", "legislativeYear", "activityTypeAndDate", "processStatus", "temporalOwner", "coverage", "memberIdentity"]},
        "operator": {"enum": ["overlaps", "on", "equals", "publishedInCalendarYear", "knownExcept", "currentAt", "knownConflict", "requires"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/inclusiveCalendarInterval"},
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 1800, "maximum": 2200}
          ]
        }
      }
    },
    "answerDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "display"],
      "properties": {
        "referent": {"type": "string", "minLength": 1},
        "display": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["start", "end", "role", "primaryEvidence"]}}
      }
    },
    "entityAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "referent", "distinctBy", "display"],
      "properties": {
        "kind": {"const": "entities"},
        "referent": {"type": "string", "minLength": 1},
        "distinctBy": {"const": "identity"},
        "display": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["name", "label", "date", "officialLink", "englishTitle", "billNumber", "year"]}},
        "details": {"type": "array", "items": {"$ref": "#/$defs/answerDetail"}},
        "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["year", "billNumber"]}},
        "preserveGaps": {"type": "boolean"},
        "preserveEpisodes": {"type": "boolean"},
        "preserveEvidence": {"type": "boolean"}
      }
    },
    "booleanAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "referent"],
      "properties": {"kind": {"const": "boolean"}, "referent": {"type": "string", "minLength": 1}}
    }
  }
}
