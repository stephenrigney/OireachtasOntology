{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.oireachtas.ie/specs/composable-query-plan.schema.json",
  "title": "Oireachtas Composable Query Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asOf", "referents", "relations", "answer"],
  "properties": {
    "version": {"const": 2},
    "asOf": {"type": "string", "format": "date"},
    "referents": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type"],
        "properties": {
          "type": {"enum": ["Member", "DailMembership", "DailTerm", "SeanadTerm", "DailConstituency", "PartyMembershipEpisode", "ParliamentaryParty", "PoliticalAffiliationIdentity", "OfficeHolding", "NamedOffice", "DebateRecord", "DebateSitting"]},
          "selector": {"type": "object", "additionalProperties": false,
            "required": ["kind", "house"], "properties": {"kind": {"const": "previousTerm"}, "house": {"const": "Dail"}}},
          "mention": {"type": "string", "minLength": 1},
          "answer": {"type": "boolean"},
          "resolution": {"enum": ["unresolved", "resolved", "ambiguous", "not_found", "source_data_unavailable", "unsupported_mapping"]},
          "iri": {"type": "string", "format": "uri"},
          "label": {"type": "string"},
          "asOfEvidence": {"type": "string", "format": "date"},
          "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["iri", "label"], "properties": {"iri": {"type": "string", "format": "uri"}, "label": {"type": "string"}}}}
        }
      }
    },
    "relations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fact", "from", "to"],
      "properties": {"id": {"type": "string", "minLength": 1}, "fact": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}
    }},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "answer": {"oneOf": [
      {"$ref": "#/$defs/entityAnswer"},
      {"$ref": "#/$defs/booleanAnswer"}
    ]}
  },
  "$defs": {
    "inclusiveCalendarInterval": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "inclusive"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "inclusive": {"const": true}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "field", "operator", "value"],
      "properties": {
        "referent": {"type": "string", "minLength": 1},
        "field": {"enum": ["interval", "date", "chamber"]},
        "operator": {"enum": ["overlaps", "on", "equals"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/inclusiveCalendarInterval"},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "episodeDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "display"],
      "properties": {
        "referent": {"type": "string", "minLength": 1},
        "display": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["start", "end"]}}
      }
    },
    "entityAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "referent", "distinctBy", "display"],
      "properties": {
        "kind": {"const": "entities"},
        "referent": {"type": "string", "minLength": 1},
        "distinctBy": {"const": "identity"},
        "display": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["name", "label", "date", "officialLink"]}},
        "details": {"type": "array", "items": {"$ref": "#/$defs/episodeDetail"}},
        "preserveGaps": {"type": "boolean"},
        "preserveEpisodes": {"type": "boolean"}
      }
    },
    "booleanAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "referent"],
      "properties": {"kind": {"const": "boolean"}, "referent": {"type": "string", "minLength": 1}}
    }
  }
}
