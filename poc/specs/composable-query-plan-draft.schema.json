{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.oireachtas.ie/specs/composable-query-plan-draft.schema.json",
  "title": "Composable Query Plan v2 Semantic Draft",
  "description": "Strict IRI-free model proposal for closed composable v2 projections or selection of a named existing validated Stage A/B/C capability or evidence boundary. Local code validates every relationship and selector, resolves local identities, and supplies the final v2 envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "supported", "family", "unsupportedReason", "intent", "referents", "relations", "constraints", "answer"],
  "properties": {
    "version": {"type": "integer", "const": 2},
    "supported": {"type": "boolean"},
    "family": {"type": ["string", "null"], "enum": ["shared_dail_terms", "member_relationship_composition", "constituency_representation", "member_party_history", "member_bill_sponsorship", "government_party_members", "capability_selection", null]},
    "unsupportedReason": {"type": ["string", "null"]},
    "intent": {"type": "string", "minLength": 1},
    "referents": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["member", "membership", "term", "constituency", "episode", "party", "affiliation", "anchor", "anchor_membership", "holding", "office"],
         "properties": {
           "member": {"$ref": "#/$defs/memberAnswerReferent"}, "membership": {"$ref": "#/$defs/membershipReferent"},
           "term": {"$ref": "#/$defs/unselectedTermReferent"},
           "constituency": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "DailConstituency"}, "mention": {"type": "null"}}},
           "episode": {"$ref": "#/$defs/partyEpisodeReferent"}, "party": {"$ref": "#/$defs/parliamentaryPartyReferent"}, "affiliation": {"$ref": "#/$defs/affiliationReferent"},
           "anchor": {"$ref": "#/$defs/namedMemberReferent"}, "anchor_membership": {"$ref": "#/$defs/membershipReferent"},
           "holding": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "OfficeHolding"}, "mention": {"type": "null"}}},
           "office": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "NamedOffice"}, "mention": {"type": "string", "minLength": 1}}}
         }},
        {"type": "object", "additionalProperties": false, "required": ["member", "cabinet", "government", "episode", "party", "affiliation"],
         "properties": {"member": {"$ref": "#/$defs/memberAnswerReferent"},
           "cabinet": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "CabinetMembership"}, "mention": {"type": "null"}}},
           "government": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "Government"}, "mention": {"type": "null"}}},
           "episode": {"$ref": "#/$defs/partyEpisodeReferent"}, "party": {"$ref": "#/$defs/parliamentaryPartyReferent"}, "affiliation": {"$ref": "#/$defs/affiliationReferent"}}},
        {"type": "object", "additionalProperties": false, "required": ["member", "episode", "party", "affiliation"],
         "properties": {"member": {"$ref": "#/$defs/namedMemberReferent"}, "episode": {"$ref": "#/$defs/partyEpisodeReferent"}, "party": {"$ref": "#/$defs/parliamentaryPartyReferent"}, "affiliation": {"$ref": "#/$defs/affiliationReferent"}}},
         {"type": "object", "additionalProperties": false, "required": ["member", "bill", "participation"],
          "properties": {"member": {"$ref": "#/$defs/namedMemberReferent"},
            "bill": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "Bill", "type": "string"}, "mention": {"type": "null"}}},
            "participation": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "BillParticipation", "type": "string"}, "mention": {"type": "null"}}}}},
         {"type": "object", "additionalProperties": false, "required": ["member", "bill", "participation", "process", "activity"],
          "properties": {"member": {"$ref": "#/$defs/namedMemberReferent"},
            "bill": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "Bill", "type": "string"}, "mention": {"type": "null"}}},
            "participation": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "BillParticipation", "type": "string"}, "mention": {"type": "null"}}},
            "process": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "BillProcess", "type": "string"}, "mention": {"type": "null"}}},
            "activity": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "BillActivity", "type": "string"}, "mention": {"type": "null"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["member", "membership", "term", "constituency"],
         "properties": {"member": {"anyOf": [{"$ref": "#/$defs/namedMemberReferent"}, {"$ref": "#/$defs/memberAnswerReferent"}]},
           "membership": {"$ref": "#/$defs/membershipReferent"},
           "term": {"type": "object", "additionalProperties": false, "required": ["type", "mention", "selector"],
              "properties": {"type": {"type": "string", "const": "DailTerm"}, "mention": {"type": "null"}, "selector": {"type": ["string", "null"], "enum": ["currentTerm", "latestRecorded", null]}}},
           "constituency": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "DailConstituency"}, "mention": {"type": ["string", "null"]}}}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_a", "membership_a", "member_b", "membership_b", "shared_term"],
          "properties": {
            "member_a": {"$ref": "#/$defs/namedMemberReferent"},
            "membership_a": {"$ref": "#/$defs/membershipReferent"},
            "member_b": {"$ref": "#/$defs/namedMemberReferent"},
            "membership_b": {"$ref": "#/$defs/membershipReferent"},
            "shared_term": {"$ref": "#/$defs/unselectedTermReferent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member", "membership_a", "term_a", "membership_b", "term_b"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership_a": {"$ref": "#/$defs/membershipReferent"},
            "term_a": {"$ref": "#/$defs/selectedTermReferent"},
            "membership_b": {"$ref": "#/$defs/membershipReferent"},
            "term_b": {"$ref": "#/$defs/selectedTermReferent"}
          }
        },
         {
           "type": "object",
           "additionalProperties": false,
           "required": ["member", "membership", "term", "constituency"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership": {"$ref": "#/$defs/membershipReferent"},
            "term": {"$ref": "#/$defs/selectedTermReferent"},
             "constituency": {"$ref": "#/$defs/constituencyReferent"}
           }
         },
         {
           "type": "object",
           "additionalProperties": false,
           "required": ["member", "membership", "term", "constituency", "anchorMember", "anchorMembership"],
           "properties": {
             "member": {"$ref": "#/$defs/memberAnswerReferent"},
             "membership": {"$ref": "#/$defs/membershipReferent"},
             "term": {"$ref": "#/$defs/selectedTermReferent"},
             "constituency": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "DailConstituency"}, "mention": {"type": "null"}}},
             "anchorMember": {"$ref": "#/$defs/namedMemberReferent"},
             "anchorMembership": {"$ref": "#/$defs/membershipReferent"}
           }
         },
         {
           "type": "object",
           "additionalProperties": false,
          "required": ["member", "membership", "term", "constituency", "episode", "party", "affiliation"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership": {"$ref": "#/$defs/membershipReferent"},
            "term": {"$ref": "#/$defs/selectedTermReferent"},
            "constituency": {"$ref": "#/$defs/constituencyReferent"},
            "episode": {"$ref": "#/$defs/partyEpisodeReferent"},
            "party": {"$ref": "#/$defs/parliamentaryPartyReferent"},
            "affiliation": {"$ref": "#/$defs/affiliationReferent"}
          }
        },
         {
           "type": "object",
           "additionalProperties": false,
           "required": ["member", "membership", "term", "episode", "party", "affiliation"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership": {"$ref": "#/$defs/membershipReferent"},
            "term": {"$ref": "#/$defs/selectedTermReferent"},
            "episode": {"$ref": "#/$defs/partyEpisodeReferent"},
            "party": {"$ref": "#/$defs/parliamentaryPartyReferent"},
             "affiliation": {"$ref": "#/$defs/affiliationReferent"}
           }
         },
         {
           "type": "object",
           "additionalProperties": false,
           "required": ["member", "membership", "term", "episode", "party", "affiliation"],
           "properties": {
             "member": {"$ref": "#/$defs/memberAnswerReferent"},
             "membership": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "SeanadMembership", "type": "string"}, "mention": {"type": "null"}}},
              "term": {"$ref": "#/$defs/selectedSeanadTermReferent"},
             "episode": {"$ref": "#/$defs/partyEpisodeReferent"},
             "party": {"$ref": "#/$defs/parliamentaryPartyReferent"},
             "affiliation": {"$ref": "#/$defs/affiliationReferent"}
           }
         },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "seanad_membership", "seanad_term", "dail_membership", "dail_term"],
           "properties": {
             "member": {"$ref": "#/$defs/memberAnswerReferent"},
             "seanad_membership": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "SeanadMembership", "type": "string"}, "mention": {"type": "null"}}},
             "seanad_term": {"$ref": "#/$defs/currentSeanadTermReferent"},
             "dail_membership": {"$ref": "#/$defs/membershipReferent"},
              "dail_term": {"$ref": "#/$defs/currentDailTermReferent"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "seanad_membership", "seanad_term", "dail_membership", "dail_term"],
            "properties": {
              "member": {"$ref": "#/$defs/memberAnswerReferent"},
              "seanad_membership": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "SeanadMembership", "type": "string"}, "mention": {"type": "null"}}},
              "seanad_term": {"$ref": "#/$defs/currentSeanadTermReferent"},
              "dail_membership": {"$ref": "#/$defs/membershipReferent"},
              "dail_term": {"$ref": "#/$defs/unselectedTermReferent"}
            }
          },
         {
           "type": "object",
          "additionalProperties": false,
          "required": ["capability", "parameters"],
          "properties": {
          "capability": {"type": "string", "enum": ["seanad_entry", "bill_lookup", "member_lookup", "dail_parties_and_groups", "office_holding_evidence", "office_holding_window", "current_committee_members"]},
            "parameters": {
                 "anyOf": [
                   {"type": "object", "additionalProperties": false, "required": ["committee"], "properties": {"committee": {"type": "string", "minLength": 1}}},
                  {"type": "object", "additionalProperties": false, "required": ["office"], "properties": {"office": {"type": "string", "minLength": 1}}},
                  {"type": "object", "additionalProperties": false, "required": ["office", "startMonth", "startYear", "endMonth", "endYear"], "properties": {"office": {"type": "string", "minLength": 1}, "startMonth": {"type": "integer", "minimum": 1, "maximum": 12}, "endMonth": {"type": "integer", "minimum": 1, "maximum": 12}, "startYear": {"type": "integer", "minimum": 1, "maximum": 9998}, "endYear": {"type": "integer", "minimum": 1, "maximum": 9998}}},
                  {"type": "object", "additionalProperties": false, "required": ["office", "date"], "properties": {"office": {"type": "string", "minLength": 1}, "date": {"type": "string", "format": "date"}}},
                  {"type": "object", "additionalProperties": false, "required": ["office", "year"], "properties": {"office": {"type": "string", "minLength": 1}, "year": {"type": "integer", "minimum": 1, "maximum": 9998}}},
                 {"type": "object", "additionalProperties": false, "required": ["member", "house"],
                  "properties": {"member": {"type": "string", "minLength": 1}, "house": {"type": ["string", "null"], "enum": ["Dail", "Seanad", null]}}},
                 {"type": "object", "additionalProperties": false, "required": ["termNumber", "includeGroups"],
                  "properties": {"termNumber": {"type": "integer", "minimum": 1, "maximum": 999}, "includeGroups": {"type": "boolean"}}},
                  {"type": "object", "additionalProperties": false, "required": ["member", "office", "selection"],
                   "properties": {"member": {"type": "string", "minLength": 1}, "office": {"type": "string", "minLength": 1}, "selection": {"type": "string", "const": "latestRecorded"}}},
                  {"type": "object", "additionalProperties": false, "required": ["member", "office"],
                  "properties": {"member": {"type": "string", "minLength": 1}, "office": {"type": "string", "minLength": 1}}},
                {"type": "object", "additionalProperties": false, "required": ["member"],
                 "properties": {"member": {"type": "string", "minLength": 1}}},
                {"type": "object", "additionalProperties": false, "required": ["billNumber", "billYear"],
                 "properties": {"billNumber": {"type": "string", "pattern": "^[0-9]+$"},
                   "billYear": {"type": "integer", "minimum": 1800, "maximum": 2200}}}
              ]
            }
          }
        }
      ]
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "constraints": {"type": "array", "items": {"anyOf": [
      {"$ref": "#/$defs/referentIntervalOverlap"},
      {"type": "object", "additionalProperties": false, "required": ["referent", "field", "operator", "value"], "properties": {"referent": {"type": "string", "const": "episode"}, "field": {"type": "string", "const": "partySeanadEpisodeInterval"}, "operator": {"type": "string", "const": "overlaps"}, "value": {"type": "string", "const": "membership"}}},
      {"type": "object", "additionalProperties": false, "required": ["referent", "field", "operator", "value"], "properties": {"referent": {"type": "string", "const": "activity"}, "field": {"type": "string", "const": "publishedDate"}, "operator": {"type": "string", "const": "inCalendarYear"}, "value": {"type": "integer", "minimum": 1800, "maximum": 2200}}},
      {"type": "object", "additionalProperties": false, "required": ["referent", "field", "operator", "value"], "properties": {"referent": {"$ref": "#/$defs/identifier"}, "field": {"type": "string", "const": "membershipInterval"}, "operator": {"type": "string", "const": "on"}, "value": {"type": "string", "format": "date"}}},
      {"type": "object", "additionalProperties": false, "required": ["referent", "field", "operator", "value"], "properties": {"referent": {"type": "string", "const": "member"}, "field": {"type": "string", "const": "identity"}, "operator": {"type": "string", "const": "distinctFrom"}, "value": {"type": "string", "const": "anchor"}}},
      {"type": "object", "additionalProperties": false, "required": ["referent", "field", "operator", "value"], "properties": {"referent": {"type": "string", "const": "holding"}, "field": {"type": "string", "const": "interval"}, "operator": {"type": "string", "const": "commonIntersection"}, "value": {"type": "array", "items": {"type": "string", "enum": ["holding", "anchor_membership", "membership", "episode"]}}}}
    ]}},
    "answer": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/answer"}
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "namedMemberReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "Member"},
        "mention": {"type": "string", "minLength": 1}
      }
    },
    "memberAnswerReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "Member"},
        "mention": {"type": "null"}
      }
    },
    "membershipReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailMembership"},
        "mention": {"type": "null"}
      }
    },
    "unselectedTermReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailTerm"},
        "mention": {"type": "null"}
      }
    },
    "selectedTermReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention", "selector"],
      "properties": {
        "type": {"type": "string", "const": "DailTerm"},
        "mention": {"type": "null"},
        "selector": {"anyOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "number"],
           "properties": {"kind": {"type": "string", "const": "termNumber"},
             "number": {"type": "integer", "minimum": 1, "maximum": 999}}},
           {"type": "object", "additionalProperties": false, "required": ["kind"],
            "properties": {"kind": {"type": "string", "const": "currentTerm"}}},
           {"type": "object", "additionalProperties": false, "required": ["kind"],
            "properties": {"kind": {"type": "string", "const": "previousTerm"}}}
         ]}
      }
    },
    "selectedSeanadTermReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention", "selector"],
      "properties": {
        "type": {"type": "string", "const": "SeanadTerm"},
        "mention": {"type": "null"},
        "selector": {"anyOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"type": "string", "const": "currentTerm"}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": {"kind": {"type": "string", "const": "termNumber"}, "number": {"type": "integer", "minimum": 1, "maximum": 999}}}
        ]}
      }
    },
    "currentSeanadTermReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention", "selector"],
      "properties": {
        "type": {"type": "string", "const": "SeanadTerm"},
        "mention": {"type": "null"},
        "selector": {"type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"type": "string", "const": "currentTerm"}}}
      }
    },
    "currentDailTermReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention", "selector"],
      "properties": {
        "type": {"type": "string", "const": "DailTerm"},
        "mention": {"type": "null"},
        "selector": {"type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"type": "string", "const": "currentTerm"}}}
      }
    },
    "constituencyReferent": {
      "anyOf": [{"$ref": "#/$defs/namedConstituencyReferent"},
        {"type": "object", "additionalProperties": false, "required": ["type", "members"], "properties": {"type": {"type": "string", "const": "DailConstituency"}, "members": {"type": "array", "items": {"$ref": "#/$defs/namedConstituencyReferent"}}}}
      ]
    },
    "namedConstituencyReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailConstituency"},
        "mention": {"type": "string", "minLength": 1}
      }
    },
    "partyEpisodeReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {"type": {"type": "string", "const": "PartyMembershipEpisode"}, "mention": {"type": "null"}}
    },
    "parliamentaryPartyReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {"type": {"type": "string", "const": "ParliamentaryParty"}, "mention": {"type": "null"}}
    },
    "affiliationReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "PoliticalAffiliationIdentity"},
        "mention": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "referentIntervalOverlap": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "field", "operator", "value"],
      "properties": {
        "referent": {"type": "string", "const": "episode"},
        "field": {"type": "string", "const": "partyEpisodeInterval"},
        "operator": {"type": "string", "const": "overlaps"},
        "value": {"type": "string", "const": "membership"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
      "fact": {"type": "string", "enum": ["member_has_membership", "membership_in_term", "membership_represents", "constituency_in_term", "member_party_membership", "party_episode_in_membership", "episode_in_parliamentary_party", "party_active_during_term", "parliamentary_party_has_affiliation_identity", "bill_has_sponsor_participation", "participation_has_participant", "bill_process_cocontained", "process_has_participation", "activity_forms_part_of_process", "member_has_cabinet_membership", "cabinet_membership_of_government", "member_has_office_holding", "office_holding_of_office", "member_has_seanad_membership", "seanad_membership_in_term", "party_episode_in_seanad_membership", "party_active_during_seanad_term"]},
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"}
      }
    },
    "answer": {"anyOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "referent", "distinctBy", "display", "details", "preserveEvidence"],
       "properties": {"kind": {"type": "string", "const": "entities"}, "referent": {"$ref": "#/$defs/identifier"},
         "distinctBy": {"type": "string", "const": "identity"}, "display": {"type": "array", "items": {"type": "string", "enum": ["label", "name"]}},
         "details": {"type": "array", "items": {"$ref": "#/$defs/answerDetail"}}, "preserveEvidence": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "referent", "distinctBy"],
       "properties": {"kind": {"type": "string", "const": "count"}, "referent": {"$ref": "#/$defs/identifier"}, "distinctBy": {"type": "string", "const": "identity"}}}
    ]},
    "answerDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "display"],
      "properties": {
        "referent": {"$ref": "#/$defs/identifier"},
        "display": {"type": "array", "items": {"type": "string", "enum": ["label", "name", "start", "end"]}}
      }
    }
  }
}
