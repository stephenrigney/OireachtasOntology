{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.oireachtas.ie/specs/composable-query-plan-draft.schema.json",
  "title": "Composable Query Plan v2 Semantic Draft",
  "description": "Strict IRI-free model proposal for closed composable v2 projections or selection of a named existing validated Stage A/B/C capability or evidence boundary. Local code validates every relationship and selector, resolves local identities, and supplies the final v2 envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "supported", "family", "unsupportedReason", "intent", "referents", "relations", "constraints", "answer"],
  "properties": {
    "version": {"type": "integer", "const": 2},
    "supported": {"type": "boolean"},
    "family": {"type": ["string", "null"], "enum": ["shared_dail_terms", "member_relationship_composition", "constituency_representation", "member_party_history", "member_bill_sponsorship", "government_party_members", "capability_selection", null]},
    "unsupportedReason": {"type": ["string", "null"]},
    "intent": {"type": "string", "minLength": 1},
    "referents": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["member", "cabinet", "government", "episode", "party", "affiliation"],
         "properties": {"member": {"$ref": "#/$defs/memberAnswerReferent"},
           "cabinet": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "CabinetMembership"}, "mention": {"type": "null"}}},
           "government": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "Government"}, "mention": {"type": "null"}}},
           "episode": {"$ref": "#/$defs/partyEpisodeReferent"}, "party": {"$ref": "#/$defs/parliamentaryPartyReferent"}, "affiliation": {"$ref": "#/$defs/affiliationReferent"}}},
        {"type": "object", "additionalProperties": false, "required": ["member", "episode", "party", "affiliation"],
         "properties": {"member": {"$ref": "#/$defs/namedMemberReferent"}, "episode": {"$ref": "#/$defs/partyEpisodeReferent"}, "party": {"$ref": "#/$defs/parliamentaryPartyReferent"}, "affiliation": {"$ref": "#/$defs/affiliationReferent"}}},
        {"type": "object", "additionalProperties": false, "required": ["member", "bill", "participation"],
         "properties": {"member": {"$ref": "#/$defs/namedMemberReferent"},
           "bill": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "Bill", "type": "string"}, "mention": {"type": "null"}}},
           "participation": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"const": "BillParticipation", "type": "string"}, "mention": {"type": "null"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["member", "membership", "term", "constituency"],
         "properties": {"member": {"anyOf": [{"$ref": "#/$defs/namedMemberReferent"}, {"$ref": "#/$defs/memberAnswerReferent"}]},
           "membership": {"$ref": "#/$defs/membershipReferent"},
           "term": {"type": "object", "additionalProperties": false, "required": ["type", "mention", "selector"],
             "properties": {"type": {"type": "string", "const": "DailTerm"}, "mention": {"type": "null"}, "selector": {"type": ["string", "null"], "enum": ["currentTerm", null]}}},
           "constituency": {"type": "object", "additionalProperties": false, "required": ["type", "mention"], "properties": {"type": {"type": "string", "const": "DailConstituency"}, "mention": {"type": ["string", "null"]}}}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_a", "membership_a", "member_b", "membership_b", "shared_term"],
          "properties": {
            "member_a": {"$ref": "#/$defs/namedMemberReferent"},
            "membership_a": {"$ref": "#/$defs/membershipReferent"},
            "member_b": {"$ref": "#/$defs/namedMemberReferent"},
            "membership_b": {"$ref": "#/$defs/membershipReferent"},
            "shared_term": {"$ref": "#/$defs/unselectedTermReferent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member", "membership_a", "term_a", "membership_b", "term_b"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership_a": {"$ref": "#/$defs/membershipReferent"},
            "term_a": {"$ref": "#/$defs/selectedTermReferent"},
            "membership_b": {"$ref": "#/$defs/membershipReferent"},
            "term_b": {"$ref": "#/$defs/selectedTermReferent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member", "membership", "term", "constituency"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership": {"$ref": "#/$defs/membershipReferent"},
            "term": {"$ref": "#/$defs/selectedTermReferent"},
            "constituency": {"$ref": "#/$defs/constituencyReferent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["member", "membership", "term", "constituency", "episode", "party", "affiliation"],
          "properties": {
            "member": {"$ref": "#/$defs/memberAnswerReferent"},
            "membership": {"$ref": "#/$defs/membershipReferent"},
            "term": {"$ref": "#/$defs/selectedTermReferent"},
            "constituency": {"$ref": "#/$defs/constituencyReferent"},
            "episode": {"$ref": "#/$defs/partyEpisodeReferent"},
            "party": {"$ref": "#/$defs/parliamentaryPartyReferent"},
            "affiliation": {"$ref": "#/$defs/affiliationReferent"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "parameters"],
          "properties": {
             "capability": {"type": "string", "enum": ["seanad_entry", "bill_lookup", "member_lookup", "dail_parties_and_groups", "office_holding_evidence"]},
            "parameters": {
               "anyOf": [
                 {"type": "object", "additionalProperties": false, "required": ["member", "house"],
                  "properties": {"member": {"type": "string", "minLength": 1}, "house": {"type": ["string", "null"], "enum": ["Dail", "Seanad", null]}}},
                 {"type": "object", "additionalProperties": false, "required": ["termNumber", "includeGroups"],
                  "properties": {"termNumber": {"type": "integer", "minimum": 1, "maximum": 999}, "includeGroups": {"type": "boolean"}}},
                 {"type": "object", "additionalProperties": false, "required": ["member", "office"],
                  "properties": {"member": {"type": "string", "minLength": 1}, "office": {"type": "string", "minLength": 1}}},
                {"type": "object", "additionalProperties": false, "required": ["member"],
                 "properties": {"member": {"type": "string", "minLength": 1}}},
                {"type": "object", "additionalProperties": false, "required": ["billNumber", "billYear"],
                 "properties": {"billNumber": {"type": "string", "pattern": "^[0-9]+$"},
                   "billYear": {"type": "integer", "minimum": 1800, "maximum": 2200}}}
              ]
            }
          }
        }
      ]
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/referentIntervalOverlap"}},
    "answer": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/answer"}
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "namedMemberReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "Member"},
        "mention": {"type": "string", "minLength": 1}
      }
    },
    "memberAnswerReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "Member"},
        "mention": {"type": "null"}
      }
    },
    "membershipReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailMembership"},
        "mention": {"type": "null"}
      }
    },
    "unselectedTermReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailTerm"},
        "mention": {"type": "null"}
      }
    },
    "selectedTermReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention", "selector"],
      "properties": {
        "type": {"type": "string", "const": "DailTerm"},
        "mention": {"type": "null"},
        "selector": {"anyOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "number"],
           "properties": {"kind": {"type": "string", "const": "termNumber"},
             "number": {"type": "integer", "minimum": 1, "maximum": 999}}},
          {"type": "object", "additionalProperties": false, "required": ["kind"],
           "properties": {"kind": {"type": "string", "const": "currentTerm"}}}
        ]}
      }
    },
    "constituencyReferent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "DailConstituency"},
        "mention": {"type": "string", "minLength": 1}
      }
    },
    "partyEpisodeReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {"type": {"type": "string", "const": "PartyMembershipEpisode"}, "mention": {"type": "null"}}
    },
    "parliamentaryPartyReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {"type": {"type": "string", "const": "ParliamentaryParty"}, "mention": {"type": "null"}}
    },
    "affiliationReferent": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mention"],
      "properties": {
        "type": {"type": "string", "const": "PoliticalAffiliationIdentity"},
        "mention": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "referentIntervalOverlap": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "field", "operator", "value"],
      "properties": {
        "referent": {"type": "string", "const": "episode"},
        "field": {"type": "string", "const": "partyEpisodeInterval"},
        "operator": {"type": "string", "const": "overlaps"},
        "value": {"type": "string", "const": "membership"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "fact": {"type": "string", "enum": ["member_has_membership", "membership_in_term", "membership_represents", "constituency_in_term", "member_party_membership", "party_episode_in_membership", "episode_in_parliamentary_party", "party_active_during_term", "parliamentary_party_has_affiliation_identity", "bill_has_sponsor_participation", "participation_has_participant", "member_has_cabinet_membership", "cabinet_membership_of_government"]},
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "referent", "distinctBy", "display", "details", "preserveEvidence"],
      "properties": {
        "kind": {"type": "string", "const": "entities"},
        "referent": {"$ref": "#/$defs/identifier"},
        "distinctBy": {"type": "string", "const": "identity"},
        "display": {"type": "array", "items": {"type": "string", "enum": ["label", "name"]}},
        "details": {"type": "array", "items": {"$ref": "#/$defs/answerDetail"}},
        "preserveEvidence": {"type": "boolean"}
      }
    },
    "answerDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["referent", "display"],
      "properties": {
        "referent": {"$ref": "#/$defs/identifier"},
        "display": {"type": "array", "items": {"type": "string", "enum": ["label", "name", "start", "end"]}}
      }
    }
  }
}
