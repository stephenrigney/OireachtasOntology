# Local-development overrides for scripts/dev-nlq.sh.
#
# Copy this file to .env.local (git-ignored) and edit it for this machine:
#
#     cp .env.local.example .env.local
#
# Only scripts/dev-nlq.sh reads .env.local. The Python application loads the
# repository-root .env with `override=False`, so the values the launcher
# resolves and exports always win.
#
# Precedence:
#     explicitly exported process-environment variables
#         > values in .env.local
#         > the launcher's local-development defaults.
#
# NLQ_LLM_API_KEY is required and has no default. Set it here or export it.
# Replace the placeholder; never commit a real key (.env.local is ignored).
#NLQ_LLM_API_KEY=replace-with-your-api-key

# Endpoint and model are optional overrides. When omitted, the launcher defaults
# to the OpenCode Console inference endpoint and GPT-6 Luna:
#     NLQ_LLM_BASE_URL=https://opencode.ai/inference/openai/v1
#     NLQ_LLM_MODEL=gpt-6-luna
# Do not append /responses to the base URL; the application adds it.
#NLQ_LLM_BASE_URL=https://opencode.ai/inference/openai/v1
#NLQ_LLM_MODEL=gpt-6-luna

# Local Fuseki endpoints. These match the bundled Docker Compose service.
#NLQ_FUSEKI_QUERY_URL=http://localhost:3030/houses/query
#OIR_FUSEKI_GSP_URL=http://localhost:3030/houses/data

# Local-development Fuseki admin credential. The launcher defaults the user to
# `admin` and the password to the documented, non-production fallback
# `oireachtas-dev` (also used by docker-compose.yml). Set these only if you need
# a different local value; never treat them as production credentials.
#OIR_FUSEKI_USER=admin
#FUSEKI_ADMIN_PASSWORD=oireachtas-dev
