# Copy to /etc/oireachtas-etl/production.env; chmod 0600 and keep outside Git.
# Paths below are host paths unless explicitly marked container-only.
OIR_PROJECT_DIR=/opt/oireachtas-etl
OIR_RUNTIME_ENV_FILE=/etc/oireachtas-etl/production.env
OIR_COMPOSE_PROJECT=oirechtas-etl-production
OIR_DURABLE_PARENT=/var/lib/oireachtas-etl-root
OIR_FUSEKI_DATA_DIR=/var/lib/oireachtas-fuseki
OIR_BACKUP_DIR=/var/backups/oireachtas-etl
OIR_RESTIC_PASSWORD_SOURCE=/etc/oireachtas-etl/restic-password
FUSEKI_BIND_PORT=3030
FUSEKI_ADMIN_PASSWORD=replace-me-at-installation
OIR_CONTAINER_UID=10001
OIR_CONTAINER_GID=10001

# Required operational integrations. Replace these paths with separately
# provisioned, protected host resources before enabling the timers.
OIR_ALERT_HOOK=/usr/local/libexec/oireachtas-alert-hook
OIR_ALERT_DEGRADED_RUN_THRESHOLD=2
OIR_ALERT_RECONCILIATION_DEGRADED_THRESHOLD=2
OIR_DRILL_ROOT=/var/lib/oireachtas-etl-drills
OIR_DRILL_COMPOSE_PROJECT=oirechtas-etl-recovery-drill
OIR_DRILL_FUSEKI_BIND_PORT=13031
OIR_DRILL_RESTIC_PASSWORD_SOURCE=/etc/oireachtas-etl/restic-drill-password
OIR_DRILL_FUSEKI_ADMIN_PASSWORD=replace-with-a-distinct-drill-password

# Initial refresh scope deliberately excludes Debates production ingestion.
OIR_DAILY_ENDPOINTS="houses parties constituencies committees administrative-units offices members bills"
OIR_RECONCILIATION_ENDPOINTS="members parties institutions office-external"

# Phase 6 defaults (operational settings, not transformation semantics).
OIR_API_LIMIT=100
OIR_API_RETRIES=3
OIR_API_TIMEOUT=30
OIR_BILLS_CURSOR_OVERLAP_SECONDS=3600
OIR_EXTERNAL_HTTP_RETRIES=3
OIR_EXTERNAL_HTTP_BACKOFF_BASE_SECONDS=0.5
OIR_EXTERNAL_HTTP_BACKOFF_MAX_SECONDS=8
OIR_WIKIDATA_CACHE_TTL_SECONDS=300
OIR_WIKIDATA_CACHE_MAX_ENTRIES=256
OIR_WIKIDATA_REQUESTS_PER_SECOND=2
OIR_DBPEDIA_CACHE_TTL_SECONDS=300
OIR_DBPEDIA_CACHE_MAX_ENTRIES=128
OIR_DBPEDIA_REQUESTS_PER_SECOND=1
OIR_BACKUP_KEEP_DAILY=30
OIR_BACKUP_KEEP_MONTHLY=12
OIR_BACKUP_RPO_HOURS=24
OIR_TMPFS_SIZE=4g
