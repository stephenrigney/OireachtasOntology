[Unit]
Description=Verify encrypted Oireachtas ETL backups and RPO
Documentation=file:/opt/oireachtas-etl/docs/development/operations.md
Requires=docker.service
After=docker.service oir-backup.service
OnFailure=oireachtas-ops-failure@%n.service

[Service]
Type=oneshot
Environment=OIR_RUNTIME_ENV_FILE=/etc/oireachtas-etl/production.env
ExecStart=/opt/oireachtas-etl/scripts/production-compose.sh ops backup check
TimeoutStartSec=0
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=6
