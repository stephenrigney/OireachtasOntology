[Unit]
Description=Oireachtas ETL Fuseki/TDB2 projection
Documentation=file:/opt/oireachtas-etl/documentation/production-operations.md
Requires=docker.service
After=docker.service
OnFailure=oirechtas-ops-failure@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=OIR_RUNTIME_ENV_FILE=/etc/oireachtas-etl/production.env
ExecStart=/opt/oireachtas-etl/scripts/production-compose.sh up-fuseki
ExecStop=/opt/oireachtas-etl/scripts/production-compose.sh stop-fuseki
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
