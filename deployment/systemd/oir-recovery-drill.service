[Unit]
Description=Disposable Oireachtas durable-state restore and Fuseki rebuild drill
Documentation=file:/opt/oireachtas-etl/documentation/production-operations.md
Requires=docker.service
After=docker.service oir-backup-check.service
OnFailure=oireachtas-ops-failure@%n.service

[Service]
Type=oneshot
Environment=OIR_RUNTIME_ENV_FILE=/etc/oireachtas-etl/production.env
ExecStart=/opt/oireachtas-etl/scripts/production-compose.sh recovery-drill
TimeoutStartSec=0
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=6
