[Unit]
Description=Encrypted Oireachtas ETL durable-state backup
Documentation=file:/opt/oireachtas-etl/documentation/production-operations.md
Requires=docker.service
After=docker.service
OnFailure=oireachtas-ops-failure@%n.service

[Service]
Type=oneshot
Environment=OIR_RUNTIME_ENV_FILE=/etc/oireachtas-etl/production.env
ExecStart=/opt/oireachtas-etl/scripts/production-compose.sh ops backup create
TimeoutStartSec=0
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=6
