PREFIX dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#>
SELECT ?status WHERE { GRAPH <https://data.oireachtas.ie/graph/bill/2025/60> { ?delivery dl:created_a_realization_of <https://data.oireachtas.ie/ie/oireachtas/bill/2025/60> ; dl:forms_part_of ?process . ?process dl:process_status ?status } }
