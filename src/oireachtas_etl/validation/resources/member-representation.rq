# {{member}} is an IRI supplied by the competency-query renderer.
SELECT ?member ?representation WHERE {
  VALUES ?member { {{member}} }
  GRAPH ?graph {
    ?member a <https://data.oireachtas.ie/ontology#Member> ;
      <https://data.oireachtas.ie/ontology/members#hasMembersMembership> ?membership .
    ?membership <https://data.oireachtas.ie/ontology/members#isRepresentativeFrom> ?representation .
  }
  FILTER(STRSTARTS(STR(?graph), "https://data.oireachtas.ie/graph/member/"))
}
ORDER BY ?member ?representation
