PREFIX members: <https://data.oireachtas.ie/ontology/members#>
PREFIX agents: <https://data.oireachtas.ie/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?party ?problem WHERE {
  { ?party a members:ParliamentaryMemberCollection ; members:partyCode "Independent" ; a members:ParliamentaryParty . BIND("Independent must not be typed ParliamentaryParty" AS ?problem) }
  UNION
  { ?party a members:ParliamentaryMemberCollection ; members:partyCode ?code ; a members:IndependentMemberCollection . FILTER(?code != "Independent") BIND("Non-Independent must not be typed IndependentMemberCollection" AS ?problem) }
  UNION
  { ?party a ?group . VALUES ?group { members:ParliamentaryGroup members:TechnicalGroup } BIND("Parties API must not assert parliamentary-group recognition" AS ?problem) }
  UNION
  { ?party members:recognisedAsParty ?target . BIND("External party reconciliation is not owned by the Parties graph" AS ?problem) }
  UNION
  { ?party owl:sameAs ?target . BIND("ParliamentaryParty must not be identified with an enduring external party" AS ?problem) }
  UNION
  { ?party prov:specializationOf ?target . BIND("ParliamentaryParty must not specialize an enduring external party" AS ?problem) }
  UNION
  { ?party members:activeDuringTerm ?term . ?term ?predicate ?object . BIND("HouseTerm description emitted outside Houses graph" AS ?problem) }
  UNION
  { ?house ?predicate ?object . FILTER(?house IN (<https://data.oireachtas.ie/house/dail>, <https://data.oireachtas.ie/house/seanad>) || REGEX(STR(?house), "^https://data\\.oireachtas\\.ie/ie/oireachtas/house/(dail|seanad)/[1-9][0-9]*$")) BIND("House or HouseTerm description emitted outside Houses graph" AS ?problem) }
  UNION
  { ?house rdf:type ?houseType . FILTER(?houseType IN (members:House, agents:HouseTerm, agents:DailTerm, agents:SeanadTerm)) BIND("House or HouseTerm type emitted outside Houses graph" AS ?problem) }
}
